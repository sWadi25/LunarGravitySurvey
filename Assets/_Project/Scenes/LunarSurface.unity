  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'You are <b>Survey One</b>, a geologist on the Moon. A <color=#FFB070>solar storm</color> reaches this site in <b>{STORM}</b>.


    <b>YOUR TASK</b>

    1.  Take the <b>Geo-Scanner</b> from the tool stand ahead.

    2.  Point it at rocks and pull the trigger to scan.

    3.  Find <b>3 high-titanium basalt</b> samples (they glow once confirmed).

    4.  Lock them into the <b>sample container</b> before the storm.


    <size=80%>Why? Titanium-rich basalt contains ilmenite, which can be processed into oxygen for future lunar bases.

    Moon gravity is 1/6 of Earth''s - dropped rocks fall slowly.</size>


    <size=75%><b>VR:</b> Grip = grab   Trigger = scan / press   Thumbstick = teleport &amp; turn

    <b>Keyboard:</b> Mouse = look   WASD = walk   Left click = grab   Right click = scan   T = teleport</size>'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
