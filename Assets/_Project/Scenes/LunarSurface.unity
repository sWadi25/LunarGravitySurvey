  m_IsActive: 1
--- !u!114 &985149800
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 985149799}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f2160c497e5d74935b7157a6cf40658b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LunarSurvey.MissionComms
  voiceSource: {fileID: 985149801}
  radioBeep: {fileID: 8300000, guid: f7c969f41a2b345339f731998240017d, type: 3}
  subtitleTargets:
  - {fileID: 265947103}
  - {fileID: 1227568152}
  - {fileID: 2137516379}
  subtitleLinger: 3
  lines:
  - id: briefing
    subtitle: Survey One, Houston. Welcome to the surface. Read the briefing board in front of you, then press Begin Mission.
    clip: {fileID: 8300000, guid: 3951720eabad04085b8382f90dc14882, type: 3}
    holdSeconds: 7
  - id: begin
    subtitle: Clock is running. A solar storm is inbound. Grab the scanner from the tool stand and find three high-titanium basalt samples.
    clip: {fileID: 8300000, guid: aa9c043d901594ce18cbba4cd2587fb0, type: 3}
    holdSeconds: 7
  - id: scanner_hint
    subtitle: Point the scanner at a rock and pull the trigger. Dark rocks are basalt, but only the scanner can confirm titanium content.
    clip: {fileID: 8300000, guid: 7c2e75722ba6e4aa882ca13e0330ec51, type: 3}
    holdSeconds: 6
  - id: target_found
    subtitle: That's a match. High-titanium basalt. Bring it back and lock it into the sample container.
    clip: {fileID: 8300000, guid: 61ab631022976431b88e15d67ac29696, type: 3}
    holdSeconds: 5
  - id: decoy_found
    subtitle: Negative, that one is not on the manifest. Keep looking.
    clip: {fileID: 8300000, guid: e238832b6e8a04cfd94d0cbcd00b5585, type: 3}
    holdSeconds: 4
  - id: unscanned_reject
    subtitle: Container won't accept an unverified sample. Scan it first.
    clip: {fileID: 8300000, guid: d8acde1a633974e8db5968799e47df8a, type: 3}
    holdSeconds: 4
  - id: decoy_reject
    subtitle: That rock isn't on the manifest. We only have room for high-titanium basalt.
    clip: {fileID: 8300000, guid: e54dc39aca7c34bcf821a448df38ede1, type: 3}
    holdSeconds: 4
  - id: sample_secured
    subtitle: Sample secured. Good work.
    clip: {fileID: 8300000, guid: 5b716981450f541919cac4b5cb5d17b0, type: 3}
    holdSeconds: 3
  - id: storm_3min
    subtitle: Three minutes until the storm front arrives.
    clip: {fileID: 8300000, guid: 5a437e340dfb14a9b934bc1504fbff3a, type: 3}
    holdSeconds: 4
  - id: storm_1min
    subtitle: One minute, Survey One. Start heading back to the lander.
    clip: {fileID: 8300000, guid: a9f0be9fccb374feca1a7a1f23ffe76e, type: 3}
    holdSeconds: 4
  - id: storm_30s
    subtitle: Thirty seconds! Secure what you have!
    clip: {fileID: 8300000, guid: 7f1cc67d6a1734d0396d79706d594ff5, type: 3}
    holdSeconds: 3
  - id: mission_success
    subtitle: Container sealed. All three samples secured before the storm. Outstanding work, Survey One. Mission complete.
    clip: {fileID: 8300000, guid: b32024abec83d4c3b91d44bf3d1164d1, type: 3}
    holdSeconds: 8
  - id: storm_hit
    subtitle: Storm front has arrived. Abort the survey and shelter in the lander. We'll try again on the next window.
    clip: {fileID: 8300000, guid: 8fafc209495364b9a9b80bb84bf0642d, type: 3}
    holdSeconds: 8
  - id: scanner_holstered
    subtitle: Scanner is clipped to your belt. Grab it from your left hip whenever you need it.
    clip: {fileID: 8300000, guid: 851cbdf2eca5449d7a79227880a634b0, type: 3}
    holdSeconds: 6
  - id: boundary_warning
    subtitle: Survey One, you're at the edge of the survey zone. Turn back toward the lander.
    clip: {fileID: 8300000, guid: b4ed2df9bed9a4902a0886488aca759b, type: 3}
    holdSeconds: 5
  - id: storm_radiation
    subtitle: Your dosimeter is picking up the leading edge of the solar particle event. Radiation is climbing. Keep moving.
    clip: {fileID: 8300000, guid: 5994d4c0499a54b788c53cde6625e13f, type: 3}
    holdSeconds: 7
